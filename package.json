{
  "name": "fmd-planning",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.13.1",
  "scripts": {
    "dev": "next dev",
    "dev:local": "node scripts/local-development.mjs dev",
    "test": "pnpm run test:vitest && pnpm run test:legacy",
    "test:vitest": "STORYBOOK_DISABLE_TELEMETRY=1 NODE_OPTIONS=--no-deprecation vitest run --passWithNoTests",
    "test:unit": "NODE_OPTIONS=--no-deprecation vitest run --project unit",
    "test:storybook": "STORYBOOK_DISABLE_TELEMETRY=1 NODE_OPTIONS=--no-deprecation vitest run --project storybook",
    "test:integration": "NODE_OPTIONS=--no-deprecation vitest run --project integration --passWithNoTests",
    "test:legacy": "tsx --test tests/*.test.tsx",
    "test:migrations": "NODE_OPTIONS=--no-deprecation vitest run --project migrations",
    "storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook dev --port 6006",
    "build-storybook": "STORYBOOK_DISABLE_TELEMETRY=1 storybook build",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "review:route": "node scripts/route-maintainability-review.mjs",
    "verify:migrations": "node scripts/verify-supabase-migrations.mjs",
    "verify:auth": "node scripts/verify-auth.mjs",
    "verify:database-security": "node scripts/verify-database-security.mjs",
    "db:migration:new": "supabase migration new",
    "db:reset": "node scripts/local-development.mjs reset",
    "local:start": "node scripts/local-development.mjs start",
    "local:reset": "node scripts/local-development.mjs reset",
    "local:seed": "node scripts/local-development.mjs seed",
    "local:stop": "node scripts/local-development.mjs stop",
    "deploy:supabase-migrations": "node scripts/deploy-production-migrations.mjs"
  },
  "dependencies": {
    "@icons-pack/react-simple-icons": "13.13.0",
    "@supabase/ssr": "^0.12.3",
    "@supabase/supabase-js": "^2.110.7",
    "driver.js": "^1.8.0",
    "lucide-react": "^1.27.0",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "10.5.7",
    "@storybook/addon-docs": "10.5.7",
    "@storybook/addon-vitest": "10.5.7",
    "@storybook/nextjs-vite": "10.5.7",
    "@storybook/react-dom-shim": "10.5.7",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "jsdom": "^30.0.1",
    "pg": "^8.22.0",
    "playwright": "1.62.1",
    "storybook": "10.5.7",
    "supabase": "2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
